<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Schedule — Steven Jewell</title><link rel="stylesheet" href="/css/style.css"></head><body>
<%- include('partials/nav') %>
<div class="hero hero-sm"><h1>Class Schedule</h1><p>Browse upcoming sessions and register</p></div>
<section class="section section-white">
  <div class="container">
    <% if (sessions.length > 0) { %>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Date</th><th>Course</th><th>Time</th><th>Location</th><th>Format</th><th>Price</th><th>Spots</th><th></th></tr></thead>
      <tbody>
      <% sessions.forEach(s => { %>
      <tr>
        <td><strong><%= s.date %></strong></td>
        <td><a href="/courses/<%= s.course ? s.course.id : '' %>"><%= s.course ? s.course.title : 'TBD' %></a></td>
        <td><%= s.time %></td>
        <td><%= s.location %></td>
        <td><span class="badge badge-<%= s.location_type %>"><%= s.location_type %></span></td>
        <td><strong>$<%= s.course ? s.course.price : '—' %></strong></td>
        <td><%= s.spots_total - s.spots_taken %> / <%= s.spots_total %></td>
        <td><a href="/portal/book/<%= s.id %>" class="btn btn-accent btn-sm">Register</a></td>
      </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
    <% } else { %>
    <div style="text-align:center;padding:3rem;"><p style="color:var(--text-light);font-size:1.1rem;">No upcoming sessions. Check back soon!</p></div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
</body></html>
