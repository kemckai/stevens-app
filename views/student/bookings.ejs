<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>My Bookings — Steven Jewell</title><link rel="stylesheet" href="/css/style.css"></head><body>
<% active = 'bookings' %>
<%- include('portal-header') %>
<h1>My Bookings</h1>
<p class="portal-sub">All your course registrations</p>
<% if (bookings.length > 0) { %>
<div class="table-wrap">
<table>
  <thead><tr><th>Course</th><th>Date</th><th>Location</th><th>Payment</th><th>Amount</th></tr></thead>
  <tbody>
  <% bookings.forEach(b => { %>
  <tr>
    <td><strong><%= b.course ? b.course.title : 'Unknown' %></strong></td>
    <td><%= b.session ? b.session.date : '—' %> <%= b.session ? b.session.time : '' %></td>
    <td><%= b.session ? b.session.location : '—' %></td>
    <td><span class="badge badge-<%= b.payment_status %>"><%= b.payment_status %></span></td>
    <td>$<%= b.amount_paid %></td>
  </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% } else { %>
<div style="text-align:center;padding:2rem;background:white;border-radius:var(--radius);box-shadow:var(--shadow);">
  <p style="color:var(--text-light);">No bookings yet.</p><a href="/courses" class="btn btn-accent" style="margin-top:1rem;">Browse Courses</a>
</div>
<% } %>
<%- include('portal-footer') %>
</body></html>
